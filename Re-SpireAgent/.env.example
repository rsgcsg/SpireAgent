# STS2 Agent Bridge REST adapter
STS2_API_URL=http://localhost:15526
STS2_MCP_TIMEOUT_MS=5000
STS2_MCP_STARTUP_WAIT_MS=60000
STS2_MCP_STARTUP_POLL_MS=500
STS2_MCP_PROTOCOL=v3
STS2_CONNECTOR_V3_COMMAND_POLL_MS=75
STS2_CONNECTOR_V3_COMMAND_TIMEOUT_MS=12000
# Required on Windows unless STS2_GAME_DIR is already set in the shell.
# STS2_GAME_DIR=D:\SteamLibrary\steamapps\common\Slay the Spire 2

# DeepSeek. Keep the real key in .env.local only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_OUTPUT_TOKENS=320
DEEPSEEK_THINKING_MODE=disabled

# Runtime and evidence
# Relative paths are anchored to Re-SpireAgent/, even when invoked with
# `npm --prefix Re-SpireAgent ...` from the repository root.
AGENT_DATA_DIR=data/runs
# unrecorded | ordinary_gameplay | operator_positioned | console_assisted | fixture
AGENT_EVIDENCE_PROVENANCE=unrecorded
AGENT_MAX_TICKS=1000
AGENT_TICK_DELAY_MS=250
AGENT_SETTLEMENT_POLL_MS=150
AGENT_SETTLEMENT_TIMEOUT_MS=3000
AGENT_END_TURN_SETTLEMENT_TIMEOUT_MS=8000
AGENT_ROOM_TRANSITION_SETTLEMENT_TIMEOUT_MS=8000
