{
  "contract_id": "sts2.human-environment",
  "protocol_version": "1.0-preview.6",
  "routes": {
    "capabilities": "/api/he/capabilities",
    "observation": "/api/he/observation",
    "reads": "/api/he/reads/{read_id}",
    "actions": "/api/he/actions",
    "control": "/api/he/controller",
    "native_page_evidence": "/api/he/evidence/native-pages/sessions"
  },
  "schemas": {
    "observation": "sts2.human-environment/observation-3",
    "action": "sts2.human-environment/action-2",
    "receipt": "sts2.human-environment/receipt-3",
    "read": "sts2.human-environment/read-2",
    "control": "sts2.human-environment/control-1",
    "native_page_evidence": "sts2.human-environment/native-page-evidence-1"
  },
  "action_verbs": [
    "activate",
    "cancel",
    "close",
    "confirm",
    "deselect",
    "end_turn",
    "open",
    "play",
    "select",
    "skip",
    "target",
    "use"
  ],
  "interaction_content": {
    "required_tags": ["surface.kind", "context.kind"],
    "unknown_kind_behavior": "observe_or_visible_unsupported_without_new_authority"
  },
  "read_kinds": ["combat_piles", "run_deck", "shop_catalog", "surface_card"],
  "evidence_profiles": [{
    "id": "native_pages.v1",
    "default_in_consumer_flow": false,
    "creates_mutation_authority": false,
    "enters_action_ledger": false,
    "snapshot_bound": true,
    "runtime_bound": true
  }]
}
