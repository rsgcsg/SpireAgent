{
  "name": "spireagent-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "SpireAgent consumer, evaluation and product workspace.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "npm --prefix Re-SpireAgent ci",
    "doctor": "node tools/consumer-doctor.mjs",
    "check": "npm run check:agent && npm run check:docs && npm run check:connector-requirements && npm run check:run-identity",
    "check:agent": "npm --prefix Re-SpireAgent run check",
    "test:agent": "npm --prefix Re-SpireAgent test",
    "build:agent": "npm --prefix Re-SpireAgent run build",
    "check:docs": "node tools/check-active-markdown-links.mjs && npm run check:current-truth",
    "check:current-truth": "node tools/check-current-truth.mjs",
    "check:connector-requirements": "node tools/check-connector-requirements.mjs",
    "check:run-identity": "node tools/test-run-identity-audit.mjs"
  }
}
