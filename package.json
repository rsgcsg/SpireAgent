{
  "name": "spireagent-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace entrypoint for Re-SpireAgent and the STS2 Live Gateway.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "npm --prefix Re-SpireAgent ci",
    "doctor": "node tools/connector.mjs doctor",
    "deploy": "node tools/connector.mjs deploy",
    "verify:loaded": "node tools/connector.mjs verify-loaded-artifact --wait",
    "check": "npm --prefix Re-SpireAgent run check",
    "check:agent": "npm --prefix Re-SpireAgent run check",
    "test:agent": "npm --prefix Re-SpireAgent test",
    "build:agent": "npm --prefix Re-SpireAgent run build",
    "check:docs": "node tools/check-active-markdown-links.mjs && npm run check:current-truth && npm run check:human-environment-contract && npm run check:human-environment-boundary",
    "check:human-environment-contract": "node tools/check-human-environment-contract.mjs",
    "check:current-truth": "node tools/check-current-truth.mjs",
    "check:human-environment-boundary": "node tools/check-human-environment-boundary.mjs",
    "check:connector-compatibility-fixtures": "node tools/test-connector-compatibility-grader.mjs",
    "check:connector-permission-fixtures": "node tools/test-connector-permission-transition-assertion.mjs",
    "check:connector-qualification": "node tools/test-connector-qualification-ledger.mjs",
    "check:connector-profiles": "node tools/test-connector-environment-profiles.mjs",
    "check:connector-migration": "node tools/test-connector-migration-orchestrator.mjs",
    "audit:connector-permission-transition": "node tools/assert-connector-permission-transition.mjs",
    "audit:connector-compatibility": "node tools/run-connector-compatibility-audit.mjs",
    "audit:connector-operation-bindings": "node tools/run-operation-binding-audit.mjs",
    "qualification:ledger": "node tools/connector-qualification-ledger.mjs",
    "migration:profiles": "node tools/connector-environment-profiles.mjs",
    "migration:cycle": "node tools/connector-migration-orchestrator.mjs",
    "connector": "node tools/connector.mjs",
    "check:connector-cli": "node tools/test-connector-cli.mjs",
    "check:connector-run-identity": "node tools/test-connector-run-identity-audit.mjs"
  }
}
